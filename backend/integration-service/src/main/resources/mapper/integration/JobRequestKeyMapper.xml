<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.procurement.integration.dao.mapper.JobRequestKeyMapper">
  <select id="selectByRequestId" resultType="com.example.procurement.integration.dao.entity.JobRequestKeyDO">
    select * from integration_schema.job_request_key where request_id=#{requestId}
  </select>
  <insert id="insert">insert into integration_schema.job_request_key(request_id,run_id,job_code,mode)
    values (#{requestId},#{runId},#{jobCode},#{mode})
  </insert>
</mapper>
