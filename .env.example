# Copy this file to .env. Values are local-development examples only.
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381

RABBITMQ_USER=procurement
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=procurement
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ES_HEAP=1g

MINIO_ROOT_USER=procurement
MINIO_ROOT_PASSWORD=change-me-minio-123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application baseline
JAVA_VERSION=17
JWT_ISSUER=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGIN=http://localhost:5173

# XXL-JOB 2.4.2 (local development examples only)
XXL_JOB_MYSQL_PORT=3307
XXL_JOB_MYSQL_USER=xxl_job
XXL_JOB_MYSQL_PASSWORD=change-me-xxl-job
XXL_JOB_MYSQL_ROOT_PASSWORD=change-me-xxl-root
XXL_JOB_ADMIN_PORT=9090
XXL_JOB_ADMIN_ADDRESSES=http://localhost:9090/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=replace-with-a-random-token
XXL_JOB_EXECUTOR_APP_NAME=procurement-integration-executor
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_ADDRESS=http://host.docker.internal:9999
XXL_JOB_LOG_PATH=./logs/xxl-job
