      "link": null,
      "locked": false,
      "text": "排查慢 SQL，针对多表 JOIN + 深分页场景调整\n联合索引，并改为基于主键游标的 Seek\nPagination。",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "排查慢 SQL，针对多表 JOIN + 深分页场景调整联合索引，并改为基于主键游标的 Seek Pagination。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
