      "boundElements": null,
      "updated": 1793888509358,
      "created": 1793888478586,
      "link": null,
      "locked": false,
      "text": "别人的简历借鉴（实习经历部分）：\n\n\n",
      "fontSize": 48.000000000000014,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "别人的简历借鉴（实习经历部分）：\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jD3Ilwfv3dGB63m7pIJ4W",
      "type": "text",
      "x": -29960,
      "y": -1120,
      "width": 960,
      "height": 147.84570249772645,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
