      "boundElements": null,
      "updated": 1793884702100,
      "created": 1793853606825,
      "link": null,
      "locked": false,
      "text": "{\n\n\"mode\":\"SOURCE_CURSOR\",\n\"sourceCursor\":\"fx:1\",\n\"snapshotId\":null,\n\"snapshotPosition\":0,\n\"baselineCursor\":null,\n\"upperCursor\":null\n\n}\n\n# 如果源端有1000条，每页查100条，则源端前9轮返回给目标端的JSON：nextCursor=\"cc:200\",\nupperCursor=\"cc:1000\", hasMore=true （这个boolean值就是指需不需要翻页）\n目标端保存：sourceCursor=\"cc:200\", upperCursor=\"cc:1000\"",
      "fontSize": 42.39999999999996,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n\n\"mode\":\"SOURCE_CURSOR\",\n\"sourceCursor\":\"fx:1\",\n\"snapshotId\":null,\n\"snapshotPosition\":0,\n\"baselineCursor\":null,\n\"upperCursor\":null\n\n}\n\n# 如果源端有1000条，每页查100条，则源端前9轮返回给目标端的JSON：nextCursor=\"cc:200\", upperCursor=\"cc:1000\", hasMore=true （这个boolean值就是指需不需要翻页）\n目标端保存：sourceCursor=\"cc:200\", upperCursor=\"cc:1000\"",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
