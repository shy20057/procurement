    {
      "id": "wozngggI75h-OTuLTcodv",
      "type": "text",
      "x": -29260,
      "y": 4020,
      "width": 800,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4k",
      "roundness": null,
      "seed": 1199971897,
      "version": 481,
      "versionNonce": 468352665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793886890254,
      "created": 1793886732092,
      "link": null,
      "locked": false,
      "text": "Admin按计划触发Handler：\n->提取调度身份并幂等创建/复用 job_run\n->检查业务开关，取得数据集租约\n->读取检查点中的首次扫描进度或固定窗口/组合\n游标\n->分页执行并提交数据和进度\n->保存业务终态\n->Handler 向Admin反馈业务成功或失败",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Admin按计划触发Handler：\n->提取调度身份并幂等创建/复用 job_run\n->检查业务开关，取得数据集租约\n->读取检查点中的首次扫描进度或固定窗口/组合游标\n->分页执行并提交数据和进度\n->保存业务终态\n->Handler 向Admin反馈业务成功或失败",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
