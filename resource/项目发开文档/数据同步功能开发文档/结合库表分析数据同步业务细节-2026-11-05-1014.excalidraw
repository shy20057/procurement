    {
      "id": "j8Wzq3N49TdBIYixIZT_k",
      "type": "text",
      "x": -1040,
      "y": 4300,
      "width": 2910.58833508506,
      "height": 345.0899848491446,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
