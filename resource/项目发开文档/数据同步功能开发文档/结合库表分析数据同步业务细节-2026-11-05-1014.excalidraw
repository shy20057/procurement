      "link": null,
      "locked": false,
      "text": "owner_id：当前租约持有者\nfence_token：栅栏令牌，只增不减\nlease_until：租约到期时间\nheartbeat：最近一次续期时间",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
