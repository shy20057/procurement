    {
      "id": "1R8JpOF3FKPWTISI4iDCh",
      "type": "text",
      "x": -6340,
      "y": 5680,
      "width": 1955.022148980034,
      "height": 741.9999999999994,
      "angle": 0,
      "strokeColor": "#e03131",
